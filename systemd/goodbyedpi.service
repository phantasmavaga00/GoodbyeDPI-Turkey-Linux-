[Unit]
Description=GoodbyeDPI Turkey - Linux DPI Bypass
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/goodbyedpi-nft-load.sh
ExecStart=/home/white/goodbyedpi-linux/bin/goodbyedpi \
    --fragment-size 5 \
    --set-ttl 5 \
    --dns-addr 9.9.9.9 \
    --dns-port 53 \
    --dnsv6-addr 2620:fe::fe \
    --dnsv6-port 53 \
    --queue-num 0
ExecStopPost=-/usr/sbin/nft delete table inet goodbyedpi
Restart=on-failure
RestartSec=5
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goodbyedpi
[Install]
WantedBy=multi-user.target
